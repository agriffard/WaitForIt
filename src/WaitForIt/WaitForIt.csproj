<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>WaitForIt</PackageId>
    <Title>WaitForIt</Title>
    <Description>Templated Blazor component for async loading/error/success UI states.</Description>
    <Authors>agriffard</Authors>
    <RepositoryUrl>https://github.com/agriffard/WaitForIt</RepositoryUrl>
    <PackageProjectUrl>https://github.com/agriffard/WaitForIt</PackageProjectUrl>
    <PackageTags>blazor;components;async;loading</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
